# BPM — nginx site template.
# Replace bpm.example.com with your domain and /opt/bpm with the install path.
# Frontend: material-kit-react/dist (production build)
# API: proxied to the NestJS process on 127.0.0.1:3010 (set PORT=3010 in bpm-api/.env)
#
# Only GET + Accept:text/html is treated as SPA navigation (hard refresh).
# POST/PATCH/DELETE always hit the API. SPA routes are exact path matches.

map "$request_method:$http_accept" $bpm_is_browser_document {
    default 0;
    "~^GET:.*text/html" 1;
}

server {
    server_name bpm.example.com;

    client_max_body_size 50M;

    # Compress JS / CSS / JSON (the API sends multi-MB JSON trees) — big speed-up on slow links.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/javascript application/javascript application/json application/xml image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root /opt/bpm/material-kit-react/dist;
    index index.html;

    # --- React SPA routes (exact paths only; never match /activities/:id/...) ---
    location ~ ^/departments/[^/]+/processes/[^/]+/(activities-table|activities-editor|activities)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri /index.html;
    }

    # Company hub SPA (e.g. /companies/FZCO/departments) — exclude API segments oracle/hana/catalog
    location ~ ^/companies/(?!oracle|hana|catalog)[^/]+/departments$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri /index.html;
    }

    location ~ ^/companies/[^/]+/settings$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri /index.html;
    }

    # --- GET paths shared with API: HTML → SPA, JSON → API ---
    location = /departments {
        if ($bpm_is_browser_document = 1) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
    }

    location = /companies {
        if ($bpm_is_browser_document = 1) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
    }

    location ~ ^/departments/[^/]+/processes$ {
        if ($bpm_is_browser_document = 1) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
    }

    # --- All other /departments/* and /companies/* → API only ---
    location ~ ^/(departments|companies)/ {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
    }

    location ~ ^/(auth|access-control|maintenance|process-documentation|ai-bpm|bpm-assistant|activity-templates|applications|activity-print|health|system-health|docx)(/|$) {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900;
        proxy_connect_timeout 300;
        proxy_send_timeout 900;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets — safe to cache; index.html must stay fresh (above).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/bpm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bpm.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = bpm.example.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name bpm.example.com;
    return 404;
}
