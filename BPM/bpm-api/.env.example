# ──────────────────────────────────────────────────────────────────────────────
# BPM API — environment template.   cp .env.example .env   and fill in values.
# Never commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# Comma-separated browser origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the web app (used in printed PDFs / generated documents).
PUBLIC_APP_URL=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=bpm

# ── Authentication & access control ───────────────────────────────────────────
NODE_ENV=development
# Generate with: openssl rand -base64 48
JWT_SECRET=
REQUIRE_JWT_AUTH=false
# Development only — NEVER enable in production (trusts an x-user-email header).
ALLOW_X_USER_EMAIL=false
# Protected administrator account (Super Admin). Created on first start if missing.
ADMINISTRATOR_EMAIL=admin@example.com
# First password for that account. If empty, a random one is printed once in the log.
ADMIN_INITIAL_PASSWORD=
# Comma-separated e-mails that may use AI Word export in addition to Super Admins.
AI_EXPORT_ALLOWED_EMAILS=

# ── Sign-in with Microsoft (optional) ─────────────────────────────────────────
CLIENT_URL=http://localhost:5173/sign-in
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
AZURE_SCOPES=openid profile email User.Read

# ── AI document generation (optional) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_WORKSPACE_ID=
# Model used by the multi-step JSON → Word pipeline (optional).
# ANTHROPIC_PIPELINE_MODEL=
# BPM assistant chat (falls back to ANTHROPIC_API_KEY / ANTHROPIC_MODEL when empty).
# BPM_ASSISTANT_API_KEY=
# BPM_ASSISTANT_MODEL=
# Directory where generated Word jobs are stored (default: ../word-jobs).
# WORD_JOBS_DIR=
# Chrome/Chromium binary used to render Mermaid diagrams and PDFs (auto-detected when empty).
# MERMAID_CHROME_PATH=

# ── Oracle Fusion HCM — companies, job roles & designations (optional) ────────
ORACLE_HCM_BASE_URL=https://your-tenant.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05
ORACLE_HCM_USER=
ORACLE_HCM_PASSWORD=

# ── SAP HANA — company branch / department lists (optional) ───────────────────
SERVER_NODE=hana-host:30015
SAP_HANA_USER=
SAP_HANA_PASSWORD=
SAP_HANA_SCHEMA=

# ── SQL Server — employee master data comparison (optional) ───────────────────
SQL_DB_SERVER=sql-host
SQL_DB_PORT=1433
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_DB_DATABASE=
# Optional comma-separated list (overrides SQL_DB_DATABASE)
# SQL_DB_DATABASES=
# SQL_DB_ENCRYPT=false
# SQL_DB_TRUST_CERT=true

# ── Policy Creator integration (optional) ─────────────────────────────────────
POLICY_CREATOR_BASE_URL=https://policy-creator.example.com
POLICY_CREATOR_POLICIES_PATH=/path/to/policy_creator/server/data/policies.json
# Optional: logo used on Policy Creator PDFs, and a default BI e-mail for company records.
# POLICY_CREATOR_LOGO_PATH=
# DEFAULT_BI_EMAIL=
