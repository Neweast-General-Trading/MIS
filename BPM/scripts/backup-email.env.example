# Copy to backup-email.env and fill in real SMTP settings (same folder).
# chmod 600 backup-email.env
#
# SMTP_FROM must be an address your provider allows (often same as SMTP_USER).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required: comma-separated recipients of the backup e-mail.
BACKUP_EMAIL_TO=admin@example.com
